# Async SQLAlchemy URL. Alembic reuses it with the sync driver.
# Running directly:     postgresql+asyncpg://USER:PASSWORD@localhost:5432/nexus_rag
# Running from docker:  postgresql+asyncpg://USER:PASSWORD@host.docker.internal:5432/nexus_rag
DATABASE_URL=

# Required. Use a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=

# Running directly: http://localhost:11434   From docker: http://host.docker.internal:11434
OLLAMA_API_URL=
DEFAULT_LLM_MODEL=mistral

# Set to false to skip loading embedding/reranker models at startup (e.g. in tests)
WARM_MODELS_ON_STARTUP=true
